## ==============================================================================
## .gitignore untuk .NET 10 Solution (Backend ASP.NET Core & Frontend Blazor Wasm)
## ==============================================================================

# Build Results & Intermediate Folders
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
publish/
dist/

# Visual Studio & JetBrains Rider
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.pidb
*.booproj
*.svclog

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Local Environment & Secrets
appsettings.*.local.json
appsettings.Local.json
*.local.json
.env
.env.*
*.env
*.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# .NET Tools & Temporary Files
.dotnet/
*.swp
*.*~
~*
*.bak

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Package & Dependency Caches
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
.nuget/
node_modules/

# Crash Dumps & Profiling
*.dmp
*.dump
*.coverage
*.coveragexml
test-results/

