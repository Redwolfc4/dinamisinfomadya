@page "/counter"

<PageTitle>Counter</PageTitle>

<div class="mb-4">
    <h1 class="text-2xl font-bold text-slate-900">Counter</h1>
    <p class="text-sm text-slate-500 mt-1">Contoh komponen interaktif Blazor dengan Tailwind CSS.</p>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 max-w-sm">
    <p role="status" class="text-sm text-slate-600 mb-4">
        Current count: <span class="font-bold text-slate-900 text-lg ml-1">@currentCount</span>
    </p>

    <button class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition cursor-pointer"
            @onclick="IncrementCount">
        Click me
    </button>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
