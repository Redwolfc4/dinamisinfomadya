@page "/weather"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Weather</PageTitle>

<div class="min-h-[calc(100vh-5.5rem)] flex flex-col">
    <div class="mb-4">
        <h1 class="text-2xl font-bold text-slate-900">Weather</h1>
        <p class="text-sm text-slate-500 mt-1">This component demonstrates fetching data from the server.</p>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div class="flex items-center gap-2 text-sm text-slate-600">
            <span>Show</span>
            <select class="px-2.5 py-1.5 rounded-lg border border-slate-300 bg-white text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
                    value="@pageSize"
                    @onchange="OnPageSizeChanged">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <span>entries</span>
        </div>

        <div class="relative w-full sm:w-72">
            <input type="text"
                   class="w-full pl-9 pr-3.5 py-2 rounded-xl border border-slate-300 bg-white text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                   placeholder="Cari semua kolom..."
                   @bind="searchQuery"
                   @bind:event="oninput"
                   @bind:after="ResetToFirstPage" />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
        </div>
    </div>

    <div class="flex-1 flex flex-col">
        <BaseTable TItem="WeatherForecast"
                   Items="PagedForecasts"
                   IsLoading="@(forecasts == null)"
                   LoadingMessage="Loading weather data..."
                   EmptyMessage="Tidak ada data cuaca yang cocok.">
            <HeaderTemplate>
                <th class="py-3.5 px-4">Date</th>
                <th class="py-3.5 px-4" aria-label="Temperature in Celsius">Temp. (C)</th>
                <th class="py-3.5 px-4" aria-label="Temperature in Fahrenheit">Temp. (F)</th>
                <th class="py-3.5 px-4">Summary</th>
            </HeaderTemplate>
            <RowTemplate Context="forecast">
                <td class="py-3.5 px-4 font-medium text-slate-900">@forecast.Date.ToShortDateString()</td>
                <td class="py-3.5 px-4 text-slate-600">@forecast.TemperatureC</td>
                <td class="py-3.5 px-4 text-slate-600">@forecast.TemperatureF</td>
                <td class="py-3.5 px-4 text-slate-700">@forecast.Summary</td>
            </RowTemplate>
        </BaseTable>
    </div>

    @if (FilteredForecasts.Count > 0)
    {
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm text-slate-600">
            <div>
                Menampilkan <span class="font-semibold text-slate-800">@StartEntry–@EndEntry</span> dari <span class="font-semibold text-slate-800">@FilteredForecasts.Count</span> data
            </div>
            <div class="flex items-center gap-1.5">
                <button type="button"
                        class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                        disabled="@(currentPage <= 1)"
                        @onclick="() => currentPage--">
                    Prev
                </button>
                @for (int p = 1; p <= TotalPages; p++)
                {
                    var pageNum = p;
                    <button type="button"
                            class="px-3 py-1.5 rounded-lg border text-xs font-semibold cursor-pointer @(pageNum == currentPage ? "bg-slate-900 text-white border-slate-900" : "bg-white text-slate-600 border-slate-200 hover:bg-slate-50")"
                            @onclick="() => currentPage = pageNum">
                        @pageNum
                    </button>
                }
                <button type="button"
                        class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-xs font-semibold text-slate-600 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                        disabled="@(currentPage >= TotalPages)"
                        @onclick="() => currentPage++">
                    Next
                </button>
            </div>
        </div>
    }
</div>

@code {
    private WeatherForecast[]? forecasts;
    private string searchQuery = string.Empty;
    private int pageSize = 10;
    private int currentPage = 1;

    private List<WeatherForecast> FilteredForecasts => forecasts == null
        ? []
        : string.IsNullOrWhiteSpace(searchQuery)
            ? forecasts.ToList()
            : forecasts.Where(f =>
                f.Date.ToShortDateString().Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                f.TemperatureC.ToString().Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                f.TemperatureF.ToString().Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (f.Summary?.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ?? false))
              .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredForecasts.Count / (double)pageSize));
    private int StartEntry => FilteredForecasts.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int EndEntry => Math.Min(currentPage * pageSize, FilteredForecasts.Count);
    private List<WeatherForecast> PagedForecasts => FilteredForecasts
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>($"{Navigation.BaseUri}sample-data/weather.json");
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            pageSize = size;
            currentPage = 1;
        }
    }

    private void ResetToFirstPage()
    {
        currentPage = 1;
    }

    public class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
