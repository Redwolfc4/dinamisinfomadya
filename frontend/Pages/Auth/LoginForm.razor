@inject AuthApiService AuthApi
@inject NavigationManager Navigation

<div class="form-content-wrap">
    <!-- App Logo -->
    <div class="brand-icon-box">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
             stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="8.5" cy="10" r="1.5" fill="currentColor" />
            <circle cx="15.5" cy="10" r="1.5" fill="currentColor" />
            <path d="M8 15a4 4 0 0 0 8 0" stroke-width="2.2" />
        </svg>
    </div>

    <!-- Heading & Subtitle -->
    <h1 class="form-heading">Welcome to AI Labs</h1>
    <p class="form-subtext">Please enter your credentials to sign in.</p>

    <!-- Login Form Fields -->
    <form @onsubmit="HandleLoginSubmit" novalidate>
        <FormInput @ref="_usernameInput" Id="login-username" Label="Username" Type="text" Placeholder="grace"
                   TabIndex="1" @bind-Value="loginUsername" Required="true" HasError="@(!string.IsNullOrEmpty(usernameError))"
                   ErrorMessage="@usernameError" />

        <FormInput @ref="_passwordInput" Id="login-password" Label="Password" IsPassword="true"
                   Placeholder="••••••••••••" TabIndex="2" @bind-Value="loginPassword" Required="true"
                   HasError="showErrorAlert" ErrorMessage="@errorMessage" />

        <!-- Options: Remember Me -->
        <div class="form-options-row">
            <label class="checkbox-label">
                <input type="checkbox" class="custom-checkbox" tabindex="3" @bind="rememberMe" />
                <span>Remember me</span>
            </label>
        </div>

        <PrimaryButton Type="submit" TabIndex="4" IsLoading="isSubmitting" LoadingText="Signing In...">
            <span>Continue</span>
        </PrimaryButton>
    </form>

    <!-- Mode Switch Prompt -->
    <div class="switch-mode-prompt">
        <span>Don't have an account?</span>
        <button type="button" class="btn-switch-mode btn-to-register" tabindex="7" @onclick="OnSwitchToRegister">Sign
            up</button>
        </div>

        <!-- Footer disclaimer -->
        <p class="form-footer-disclaimer">
            By continuing, you agree to our <a href="/terms" tabindex="8">Terms of Service</a> and <a href="/privacy"
                                                                                                      tabindex="9">Privacy Policy</a>.
        </p>
    </div>

@code {
    [Parameter] public EventCallback OnSwitchToRegister { get; set; }
    [Parameter] public EventCallback<(string Type, string Message)> OnNotify { get; set; }

    private FormInput? _usernameInput;
    private FormInput? _passwordInput;

    private string loginUsername = "";
    private string loginPassword = "";
    private bool rememberMe = true;
    private bool showErrorAlert = false;
    private string usernameError = string.Empty;
    private string errorMessage = string.Empty;
    private bool isSubmitting = false;

    private async Task HandleLoginSubmit()
    {
        usernameError = string.Empty;
        showErrorAlert = false;
        errorMessage = string.Empty;

        bool hasValidationError = false;
        if (string.IsNullOrWhiteSpace(loginUsername))
        {
            usernameError = "Username wajib diisi.";
            hasValidationError = true;
        }

        if (string.IsNullOrWhiteSpace(loginPassword))
        {
            showErrorAlert = true;
            errorMessage = "Password wajib diisi.";
            hasValidationError = true;
        }

        if (hasValidationError)
        {
            if (!string.IsNullOrEmpty(usernameError) && _usernameInput is not null)
            {
                await _usernameInput.FocusAsync();
            }
            else if (showErrorAlert && _passwordInput is not null)
            {
                await _passwordInput.FocusAsync();
            }
            return;
        }

        isSubmitting = true;
        StateHasChanged();

        var response = await AuthApi.LoginAsync(new LoginRequestDto
        {
            Username = loginUsername,
            Password = loginPassword
        }, rememberMe);

        isSubmitting = false;

        if (!response.Success)
        {
            var msg = string.IsNullOrWhiteSpace(response.Message)
                ? "Login gagal. Silakan periksa username dan password Anda."
                : response.Message;

            if (!response.IsLocked && response.LoginFailedCount > 0)
            {
                var maxAttempts = response.MaxLoginAttempts > 0 ? response.MaxLoginAttempts : 3;
                msg = $"{msg} (Percobaan gagal: {response.LoginFailedCount}/{maxAttempts})";
            }

            var toastType = response.IsLocked ? "Warning" : "Error";
            await OnNotify.InvokeAsync((toastType, msg));

            if (response.IsLocked)
            {
                await Task.Delay(800);
                Navigation.NavigateTo("/locked");
                return;
            }

            if (_passwordInput is not null)
            {
                await _passwordInput.FocusAsync();
            }
            return;
        }

        showErrorAlert = false;
        errorMessage = string.Empty;
        await OnNotify.InvokeAsync(("Success", response.Message));
        await Task.Delay(800);
        Navigation.NavigateTo("/counter");
    }
}

