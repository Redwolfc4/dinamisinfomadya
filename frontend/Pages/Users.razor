@page "/users"
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
@inject UserApiService UserApi

<PageTitle>Manajemen User</PageTitle>

<div class="min-h-[calc(100vh-5.5rem)] flex flex-col min-w-0 w-full">
    <div class="mb-4">
        <h1 class="text-2xl font-bold text-slate-900">Manajemen User</h1>
        <p class="text-sm text-slate-500 mt-1">Kelola informasi pengguna, status kunci akun, dan soft delete.</p>
    </div>

    <BaseToast IsVisible="@(!string.IsNullOrWhiteSpace(alertMessage))" Message="@alertMessage"
               Type="@(isAlertError ? "Error" : "Success")" OnDismiss="() => alertMessage = string.Empty" />

    <!-- Toolbar: Show & Universal Search -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
        <div class="flex items-center gap-2 text-sm text-slate-600">
            <span>Show</span>
            <select
                class="px-2.5 py-1.5 rounded-lg border border-slate-300 bg-white text-sm font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
                value="@pageSize" @onchange="OnPageSizeChanged">
                <option value="5">5</option>
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <span>entries</span>
        </div>

        <SearchInput Placeholder="Cari semua kolom..." @bind-Value="searchQuery"
                     OnDebouncedSearch="HandleDebouncedSearchAsync" />
    </div>

    <div class="flex-1 flex flex-col">
        <BaseTable TItem="UserDto" Items="users" IsLoading="isLoading" LoadingMessage="Memuat data pengguna..."
                   EmptyMessage="Belum ada data pengguna aktif.">
            <HeaderTemplate>
                <th class="py-3.5 px-4">Nama Lengkap</th>
                <th class="py-3.5 px-4">Username</th>
                <th class="py-3.5 px-4">Status</th>
                <th class="py-3.5 px-4">Gagal Login</th>
                <th class="py-3.5 px-4">Dibuat</th>
                <th class="py-3.5 px-4">Diperbarui</th>
                <th class="py-3.5 px-4">Dihapus</th>
                <th class="py-3.5 px-4 text-center">Aksi</th>
            </HeaderTemplate>
            <RowTemplate Context="user">
                <td class="py-3.5 px-4 font-medium text-slate-900">@user.FullName</td>
                <td class="py-3.5 px-4 text-slate-600">@user.Username</td>
                <td class="py-3.5 px-4">
                    @if (user.IsLocked)
                    {
                        <span class="text-xs font-semibold text-red-600">
                            🔒 Terkunci
                        </span>
                    }
                    else
                    {
                        <span class="text-xs font-semibold text-emerald-600">
                            ✓ Aktif
                        </span>
                    }
                </td>
                <td class="py-3.5 px-4">@user.LoginFailed / 3</td>
                <td class="py-3.5 px-4 text-slate-500">@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td class="py-3.5 px-4 text-slate-500">@user.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                <td class="py-3.5 px-4 text-slate-500">@(user.DeletedAt.HasValue?
                                    user.DeletedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "-")</td>
                    <td class="py-3.5 px-4 text-center">
                        <ActionMenu>
                            <button type="button"
                                    class="w-full px-3.5 py-2 text-left text-xs font-semibold text-slate-700 hover:bg-slate-100 transition cursor-pointer flex items-center gap-2"
                                    @onclick="() => OpenDetailModal(user)">
                                <span>Detail</span>
                            </button>
                            <button type="button"
                                    class="w-full px-3.5 py-2 text-left text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 transition cursor-pointer flex items-center gap-2"
                                    @onclick="() => OpenEditModal(user)">
                                <span>Edit</span>
                            </button>
                            <button type="button"
                                    class="w-full px-3.5 py-2 text-left text-xs font-semibold text-red-600 hover:bg-red-50 transition cursor-pointer flex items-center gap-2"
                                    @onclick="() => OpenDeleteModal(user)">
                                <span>Delete</span>
                            </button>
                        </ActionMenu>
                    </td>
                </RowTemplate>
            </BaseTable>
        </div>

        @if (!isLoading && users.Any())
        {
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-4 pt-2 text-sm text-slate-600">
                <div>
                    Menampilkan <span class="font-semibold text-slate-800">@StartEntry</span>–<span
                    class="font-semibold text-slate-800">@EndEntry</span> dari <span
                    class="font-semibold text-slate-800">@totalCount</span> data
                </div>
                <div class="flex items-center gap-1.5">
                    <button type="button"
                            class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                            disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">
                        Prev
                    </button>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        var pageNum = p;
                        <button type="button"
                                class="px-3 py-1.5 rounded-lg text-xs font-semibold transition cursor-pointer @(currentPage == pageNum ? "bg-slate-900 text-white" : "border border-slate-300 bg-white text-slate-700 hover:bg-slate-50")"
                                @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }
                    <button type="button"
                            class="px-3 py-1.5 rounded-lg border border-slate-300 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
                            disabled="@(currentPage >= totalPages)" @onclick="() => GoToPage(currentPage + 1)">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>

<BaseModal IsOpen="@(detailingUser != null)"
           Title="Detail Pengguna"
           MaxWidthClass="max-w-xl"
           OnClose="() => detailingUser = null">
    <ChildContent>
        @if (detailingUser != null)
        {
            <div class="space-y-6 text-sm">
                <!-- User Profile Section -->
                <div class="flex items-center justify-between gap-4 pb-5 border-b border-slate-200">
                    <div class="flex items-center gap-3.5 min-w-0">
                        <div class="w-11 h-11 rounded-full bg-slate-100 border border-slate-200 flex items-center justify-center text-sm font-semibold text-slate-700 shrink-0">
                            @GetInitials(detailingUser.FullName)
                        </div>
                        <div class="min-w-0">
                            <p class="text-base font-semibold text-slate-900 truncate">@detailingUser.FullName</p>
                            <p class="text-xs text-slate-500 truncate">@@@detailingUser.Username</p>
                        </div>
                    </div>
                    @if (detailingUser.IsLocked)
                    {
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-600 shrink-0">
                            <span class="w-2 h-2 rounded-full bg-red-600"></span>
                            Terkunci
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-600 shrink-0">
                            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                            Aktif
                        </span>
                    }
                </div>

                <!-- Informasi Akun -->
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Informasi Akun</p>
                    <div class="divide-y divide-slate-100">
                        <div class="flex items-center justify-between py-3 gap-4">
                            <span class="text-[13px] text-slate-500">Full Name</span>
                            <span class="text-sm font-medium text-slate-900 text-right">@detailingUser.FullName</span>
                        </div>
                        <div class="flex items-center justify-between py-3 gap-4">
                            <span class="text-[13px] text-slate-500">Username</span>
                            <span class="text-sm font-medium text-slate-900 text-right">@detailingUser.Username</span>
                        </div>
                        <div class="flex items-center justify-between py-3 gap-4">
                            <span class="text-[13px] text-slate-500">Status</span>
                            <span class="text-sm font-medium @(detailingUser.IsLocked ? "text-red-600" : "text-emerald-600") text-right">
                                @(detailingUser.IsLocked ? "Terkunci" : "Aktif")
                            </span>
                        </div>
                        <div class="flex items-center justify-between py-3 gap-4">
                            <span class="text-[13px] text-slate-500">Gagal Login</span>
                            <span class="text-sm font-medium @(detailingUser.LoginFailed > 0 ? "text-red-600" : "text-slate-900") text-right">
                                @detailingUser.LoginFailed kali
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Audit Trail -->
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Audit Trail</p>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="border-b border-slate-200 text-xs font-semibold text-slate-500">
                                    <th class="py-2.5 pr-3">Aktivitas</th>
                                    <th class="py-2.5 px-3">Oleh</th>
                                    <th class="py-2.5 pl-3 text-right">Waktu</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-sm">
                                <tr>
                                    <td class="py-3 pr-3 font-medium text-slate-800">Dibuat</td>
                                    <td class="py-3 px-3 text-slate-600">@(detailingUser.CreatedBy?.ToString() ?? "—")</td>
                                    <td class="py-3 pl-3 text-slate-600 text-right whitespace-nowrap">@detailingUser.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                </tr>
                                <tr>
                                    <td class="py-3 pr-3 font-medium text-slate-800">Diperbarui</td>
                                    <td class="py-3 px-3 text-slate-600">@(detailingUser.UpdatedBy?.ToString() ?? "—")</td>
                                    <td class="py-3 pl-3 text-slate-600 text-right whitespace-nowrap">@detailingUser.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                </tr>
                                <tr>
                                    <td class="py-3 pr-3 font-medium text-slate-800">Dihapus</td>
                                    <td class="py-3 px-3 text-slate-600">@(detailingUser.DeletedBy?.ToString() ?? "—")</td>
                                    <td class="py-3 pl-3 text-slate-600 text-right whitespace-nowrap">@(detailingUser.DeletedAt.HasValue ? detailingUser.DeletedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm") : "—")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button"
                class="px-4 py-2 rounded-xl text-sm font-semibold bg-slate-900 hover:bg-slate-800 text-white transition cursor-pointer"
                @onclick="() => detailingUser = null">
            Tutup
        </button>
    </FooterContent>
</BaseModal>

                    <BaseModal IsOpen="@(editingUser != null)" Title="Edit Pengguna" MaxWidthClass="max-w-md" OnClose="CloseEditModal">
                        <form @onsubmit="HandleEditSubmit" novalidate>
                            <div class="mb-4">
                                <label class="block text-xs font-semibold text-slate-700 mb-1.5">Full Name <span class="text-red-500 ml-0.5"
                                                                                                                     aria-hidden="true">*</span></label>
                                    <input type="text" required
                                           class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                           @bind="editFullName" @bind:event="oninput" />
                                </div>

                                <input type="hidden" value="@editUsername" />

                                <div class="mb-4">
                                    <label class="block text-xs font-semibold text-slate-700 mb-1.5">Password Baru <span
                                        class="font-normal text-slate-400">(Opsional)</span></label>
                                        <input type="password"
                                               class="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                                               placeholder="Kosongkan jika tidak ingin mengubah password" @bind="editPassword" @bind:event="oninput" />
                                    </div>

                                    <div class="mb-5 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
                                        <label class="flex items-center justify-between cursor-pointer">
                                            <div>
                                                <span class="block text-sm font-semibold text-slate-800">Status Terkunci (Locked)</span>
                                                <span class="block text-xs text-slate-500 mt-0.5">
                                                    @(editIsLocked ? "Akun dikunci dan tidak bisa login." : "Jika dinonaktifkan, gagal login otomatis di-reset ke 0.")
                                                </span>
                                            </div>
                                            <input type="checkbox" class="w-4 h-4 accent-indigo-600 cursor-pointer" @bind="editIsLocked" />
                                        </label>
                                    </div>

                                    <div class="flex justify-end gap-2">
                                        <button type="button"
                                                class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition cursor-pointer"
                                                @onclick="CloseEditModal" disabled="@isSubmitting">
                                            Batal
                                        </button>
                                        <button type="submit"
                                                class="px-4 py-2 rounded-xl text-sm font-semibold bg-slate-900 hover:bg-slate-800 text-white transition cursor-pointer inline-flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                                                disabled="@(isSubmitting || !HasEditChanges)">
                                            @if (isSubmitting)
                                            {
                                                <span class="inline-block w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></span>
                                                <span>Menyimpan...</span>
                                            }
                                            else
                                            {
                                                <span>Simpan Perubahan</span>
                                            }
                                        </button>
                                    </div>
                                </form>
                            </BaseModal>

                            <BaseModal IsOpen="@(deletingUser != null)" Title="Hapus Pengguna?" MaxWidthClass="max-w-sm"
                                       OnClose="() => deletingUser = null">
                                @if (deletingUser != null)
                                {
                                    <p class="text-sm text-slate-600 mb-5">
                                        Pengguna <strong>@deletingUser.FullName</strong> (@@@deletingUser.Username) akan dihapus secara <em>soft
                                        delete</em>.
                                    </p>
                                    <div class="flex justify-end gap-2">
                                        <button type="button"
                                                class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition cursor-pointer"
                                                @onclick="() => deletingUser = null" disabled="@isSubmitting">
                                            Batal
                                        </button>
                                        <button type="button"
                                                class="px-4 py-2 rounded-xl text-sm font-semibold bg-red-600 hover:bg-red-700 text-white transition cursor-pointer"
                                                @onclick="HandleDeleteConfirm" disabled="@isSubmitting">
                                            @(isSubmitting ? "Menghapus..." : "Ya, Hapus")
                                        </button>
                                    </div>
                                }
                            </BaseModal>

@code {
    private List<UserDto> users = [];
    private bool isLoading = true;
    private string searchQuery = string.Empty;
    private int pageSize = 10;
    private int currentPage = 1;
    private int totalCount = 0;
    private int totalPages = 1;

    private int StartEntry => totalCount == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int EndEntry => Math.Min(currentPage * pageSize, totalCount);

    private async Task HandleDebouncedSearchAsync(string query)
    {
        searchQuery = query;
        currentPage = 1;
        await LoadUsersAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0)
        {
            pageSize = size;
            currentPage = 1;
            await LoadUsersAsync();
        }
    }

    private async Task GoToPage(int page)
    {
        currentPage = Math.Clamp(page, 1, totalPages);
        await LoadUsersAsync();
    }
    private bool isSubmitting = false;
    private string alertMessage = string.Empty;
    private bool isAlertError = false;

    private UserDto? detailingUser;
    private UserDto? editingUser;
    private string editFullName = string.Empty;
    private string editUsername = string.Empty;
    private string editPassword = string.Empty;
    private bool editIsLocked;

    private UserDto? deletingUser;
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();

        _hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5266/hubs/users")
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On("UserUpdated", async () =>
        {
            await LoadUsersAsync();
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch
        {
            // Abaikan jika koneksi realtime belum tersedia saat ini
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
        {
            await _hubConnection.DisposeAsync();
        }
    }

    private async Task LoadUsersAsync()
    {
        isLoading = true;
        var (success, message, data, count, pages) = await UserApi.GetUsersPagedAsync(searchQuery, currentPage, pageSize);
        isLoading = false;

        if (!success)
        {
            ShowAlert(message, true);
            return;
        }

        users = data;
        totalCount = count > 0 ? count : data.Count;
        totalPages = pages;
    }

    private void OpenDetailModal(UserDto user)
    {
        detailingUser = user;
    }

    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][0].ToString().ToUpperInvariant()
            : $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[1][0])}";
    }

    private void OpenEditModal(UserDto user)
    {
        editingUser = user;
        editFullName = user.FullName;
        editUsername = user.Username;
        editPassword = string.Empty;
        editIsLocked = user.IsLocked;
    }

    private void CloseEditModal()
    {
        editingUser = null;
    }

    private bool HasEditChanges =>
        editingUser != null &&
        (editFullName.Trim() != editingUser.FullName ||
         editIsLocked != editingUser.IsLocked ||
         !string.IsNullOrWhiteSpace(editPassword));

    private async Task HandleEditSubmit()
    {
        if (editingUser == null || isSubmitting || !HasEditChanges) return;

        if (string.IsNullOrWhiteSpace(editFullName) || editFullName.Trim().Length < 3)
        {
            ShowAlert("Full Name minimal 3 karakter.", true);
            return;
        }

        if (string.IsNullOrWhiteSpace(editUsername) || editUsername.Trim().Length < 3)
        {
            ShowAlert("Username minimal 3 karakter.", true);
            return;
        }

        if (!string.IsNullOrWhiteSpace(editPassword) &&
            (editPassword.Length < 8 ||
             !editPassword.Any(char.IsLower) ||
             !editPassword.Any(char.IsUpper) ||
             !editPassword.Any(char.IsDigit) ||
             !editPassword.Any(ch => "!@#$%^&*".Contains(ch))))
        {
            ShowAlert("Password minimal 8 karakter dan harus mengandung huruf kecil, huruf besar, angka, serta simbol (!@#$%^&*).",
true);
            return;
        }

        isSubmitting = true;
        var (success, message) = await UserApi.UpdateUserAsync(editingUser.Id, new UpdateUserRequestDto
        {
            FullName = editFullName.Trim(),
            Username = editUsername.Trim(),
            IsLocked = editIsLocked,
            Password = string.IsNullOrWhiteSpace(editPassword) ? null : editPassword
        });
        isSubmitting = false;

        if (!success)
        {
            ShowAlert(message, true);
            return;
        }

        editingUser = null;
        ShowAlert(message, false);
        await LoadUsersAsync();
    }

    private void OpenDeleteModal(UserDto user)
    {
        deletingUser = user;
    }

    private async Task HandleDeleteConfirm()
    {
        if (deletingUser == null) return;

        isSubmitting = true;
        var (success, message) = await UserApi.DeleteUserAsync(deletingUser.Id);
        isSubmitting = false;

        deletingUser = null;
        ShowAlert(message, !success);

        if (success)
        {
            await LoadUsersAsync();
        }
    }

    private void ShowAlert(string message, bool isError)
    {
        alertMessage = message;
        isAlertError = isError;
    }
}
