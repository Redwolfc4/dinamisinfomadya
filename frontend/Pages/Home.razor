@page "/"
@layout AuthLayout

<PageTitle>AI Labs — Select &amp; Combine &amp; Integrate</PageTitle>

<div class="auth-page-root">
    <!-- Browser Window Card (macOS Safari/Chrome Mock as in user screenshot) -->
    <div class="browser-window @(isFullscreen ? "fullscreen-mode" : "")">
        <!-- Browser Top Bar -->
        <div class="browser-header">
            <!-- macOS Traffic Light Buttons -->
            <div class="traffic-lights">
                <span class="traffic-dot close" title="Close" @onclick="HandleWindowClose"></span>
                <span class="traffic-dot minimize" title="Minimize" @onclick="HandleWindowMinimize"></span>
                <span class="traffic-dot maximize" title="Toggle Fullscreen" @onclick="ToggleFullscreen"></span>
            </div>

            <!-- Browser Navigation Buttons -->
            <div class="browser-nav-actions">
                <button type="button" class="browser-nav-btn" title="Back" @onclick="ToggleMode">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button type="button" class="browser-nav-btn" title="Forward" @onclick="ToggleMode">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            </div>

            <!-- Address Bar (labs.ai) -->
            <div class="address-bar-wrapper">
                <div class="address-bar">
                    <!-- Shield / Lock icon -->
                    <svg class="lock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    <span>labs.ai@(isRegisterMode ? "/register" : "/login")</span>
                    <!-- Refresh icon -->
                    <svg class="refresh-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" @onclick="ResetForm">
                        <polyline points="23 4 23 10 17 10"/>
                        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                    </svg>
                </div>
            </div>

            <!-- Right Browser Actions -->
            <div class="browser-right-actions">
                <!-- Share icon -->
                <button type="button" class="browser-nav-btn" title="Share" @onclick="HandleShare">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                </button>
                <!-- Plus Tab icon -->
                <button type="button" class="browser-nav-btn" title="New Tab" @onclick="ToggleMode">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </button>
                <!-- Grid icon -->
                <button type="button" class="browser-nav-btn" title="All Tabs" @onclick="HandleTabsGrid">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                </button>
            </div>
        </div>

        <!-- Top Interactive Controls Bar -->
        <div class="top-status-bar">
            <div>
                <span class="mode-badge @(isRegisterMode ? "register-active" : "")">
                    @(isRegisterMode ? "✨ Register Mode" : "🔐 Sign In Mode")
                </span>
                <span style="margin-left: 8px; color: #6b7280;">
                    Animation: <strong>Cubic-Bezier Panel Swap</strong>
                </span>
            </div>

            <div class="status-actions">
                <button type="button" class="btn-pill-sm" @onclick="ToggleShowError">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    Toggle Error Demo
                </button>

                <button type="button" class="btn-pill-sm" @onclick="ToggleMode">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
                    Switch to @(isRegisterMode ? "Sign In" : "Register")
                </button>

                <button type="button" class="btn-pill-sm" @onclick="ToggleFullscreen">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                    @(isFullscreen ? "Exit Fullscreen" : "Fullscreen")
                </button>
            </div>
        </div>

        <!-- ===================================================================
             MAIN SPLIT VIEW: Sliding Transition Between Left and Right
             =================================================================== -->
        <div class="auth-stage @(isRegisterMode ? "mode-register" : "mode-login")">
            <!-- PANEL 1: Form Panel (Left in Login mode, Slides to Right in Register mode) -->
            <div class="auth-panel panel-form">
                @if (!isRegisterMode)
                {
                    <!-- =======================================================
                         LOGIN FORM (Exact match to screenshot)
                         ======================================================= -->
                    <div class="form-content-wrap">
                        <!-- App Logo (Squircle with smile face) -->
                        <div class="brand-icon-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="5" />
                                <circle cx="8.5" cy="10" r="1.5" fill="currentColor" />
                                <circle cx="15.5" cy="10" r="1.5" fill="currentColor" />
                                <path d="M8 15a4 4 0 0 0 8 0" stroke-width="2.2" />
                            </svg>
                        </div>

                        <!-- Heading & Subtitle -->
                        <h1 class="form-heading">Welcome to AI Labs</h1>
                        <p class="form-subtext">Please sign in or sign up with your Google account.</p>

                        <!-- Social Sign-In Buttons -->
                        <div class="social-buttons-stack">
                            <!-- Google Button -->
                            <button type="button" class="btn-social" @onclick="HandleSocialLoginGoogle">
                                <span class="social-icon-wrapper">
                                    <svg width="18" height="18" viewBox="0 0 24 24">
                                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                    </svg>
                                </span>
                                <span class="btn-social-text">Sign in with Google</span>
                            </button>

                            <!-- GitHub Button -->
                            <button type="button" class="btn-social" @onclick="HandleSocialLoginGitHub">
                                <span class="social-icon-wrapper">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#24292e">
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                                    </svg>
                                </span>
                                <span class="btn-social-text">Sign in with GitHub</span>
                            </button>
                        </div>

                        <!-- OR Divider -->
                        <div class="or-divider">
                            <span>OR</span>
                        </div>

                        <!-- Login Form Fields -->
                        <form @onsubmit="HandleLoginSubmit">
                            <!-- Email -->
                            <div class="form-field-group">
                                <label class="form-label" for="login-email">Email</label>
                                <div class="input-container">
                                    <input id="login-email" 
                                           type="email" 
                                           class="form-input" 
                                           placeholder="grace@org.com" 
                                           @bind="loginEmail" 
                                           required />
                                </div>
                            </div>

                            <!-- Password with Eye Toggle -->
                            <div class="form-field-group">
                                <label class="form-label" for="login-password">Password</label>
                                <div class="input-container @(showErrorAlert ? "has-error" : "")">
                                    <input id="login-password" 
                                           type="@(showPassword ? "text" : "password")" 
                                           class="form-input" 
                                           placeholder="••••••••••••" 
                                           @bind="loginPassword" 
                                           required />
                                    <button type="button" class="btn-eye-toggle" @onclick="() => showPassword = !showPassword" title="Toggle password visibility">
                                        @if (showPassword)
                                        {
                                            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                        }
                                        else
                                        {
                                            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        }
                                    </button>
                                </div>

                                <!-- Error Alert Banner (matching screenshot) -->
                                @if (showErrorAlert)
                                {
                                    <div class="form-error-alert">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                                            <circle cx="12" cy="12" r="10" />
                                            <line x1="12" y1="8" x2="12" y2="12" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
                                            <line x1="12" y1="16" x2="12.01" y2="16" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
                                        </svg>
                                        <span>Please enter the correct password</span>
                                    </div>
                                }
                            </div>

                            <!-- Options: Remember Me & Forgot Password -->
                            <div class="form-options-row">
                                <label class="checkbox-label">
                                    <input type="checkbox" class="custom-checkbox" @bind="rememberMe" />
                                    <span>Remember me</span>
                                </label>
                                <a href="javascript:void(0)" class="link-forgot" @onclick="HandleForgotPassword">
                                    Forgot password?
                                </a>
                            </div>

                            <!-- Continue Button -->
                            <button type="submit" class="btn-primary-action" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span style="display: inline-block; width: 14px; height: 14px; border: 2px solid #ffffff; border-top-color: transparent; border-radius: 50%; animation: spin 0.6s linear infinite;"></span>
                                    <span>Signing In...</span>
                                }
                                else
                                {
                                    <span>Continue</span>
                                }
                            </button>
                        </form>

                        <!-- Trouble Signing In -->
                        <div class="help-links-wrap">
                            <a href="javascript:void(0)" class="link-help" @onclick="HandleTroubleSignIn">
                                Have trouble signing in?
                            </a>
                        </div>

                        <!-- Mode Switch Prompt -->
                        <div class="switch-mode-prompt">
                            <span>Don't have an account?</span>
                            <button type="button" class="btn-switch-mode btn-to-register" @onclick="ToggleMode">Sign up</button>
                        </div>

                        <!-- Footer disclaimer -->
                        <p class="form-footer-disclaimer">
                            By continuing, you agree to our <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.
                        </p>
                    </div>
                }
                else
                {
                    <!-- =======================================================
                         REGISTER FORM (Clean, High-Converting Signup)
                         ======================================================= -->
                    <div class="form-content-wrap">
                        <!-- App Logo -->
                        <div class="brand-icon-box" style="background: #1e1b4b;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#a5b4fc" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                <circle cx="8.5" cy="7" r="4" />
                                <line x1="20" y1="8" x2="20" y2="14" />
                                <line x1="23" y1="11" x2="17" y2="11" />
                            </svg>
                        </div>

                        <!-- Heading & Subtitle -->
                        <h1 class="form-heading">Create your Account</h1>
                        <p class="form-subtext">Join AI Labs to build, integrate, and deploy AI models.</p>

                        <!-- Social Sign-Up Buttons -->
                        <div class="social-buttons-stack">
                            <button type="button" class="btn-social" @onclick="HandleSocialLoginGoogle">
                                <span class="social-icon-wrapper">
                                    <svg width="18" height="18" viewBox="0 0 24 24">
                                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                                    </svg>
                                </span>
                                <span class="btn-social-text">Sign up with Google</span>
                            </button>

                            <button type="button" class="btn-social" @onclick="HandleSocialLoginGitHub">
                                <span class="social-icon-wrapper">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#24292e">
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                                    </svg>
                                </span>
                                <span class="btn-social-text">Sign up with GitHub</span>
                            </button>
                        </div>

                        <!-- OR Divider -->
                        <div class="or-divider">
                            <span>OR REGISTER WITH EMAIL</span>
                        </div>

                        <!-- Registration Form -->
                        <form @onsubmit="HandleRegisterSubmit">
                            <!-- Full Name -->
                            <div class="form-field-group">
                                <label class="form-label" for="reg-fullname">Full Name</label>
                                <input id="reg-fullname" 
                                       type="text" 
                                       class="form-input" 
                                       placeholder="Grace Hopper" 
                                       @bind="registerFullName" 
                                       required />
                            </div>

                            <!-- Username -->
                            <div class="form-field-group">
                                <label class="form-label" for="reg-username">Username</label>
                                <input id="reg-username" 
                                       type="text" 
                                       class="form-input" 
                                       placeholder="grace_hopper" 
                                       @bind="registerUsername" 
                                       required />
                            </div>

                            <!-- Work Email -->
                            <div class="form-field-group">
                                <label class="form-label" for="reg-email">Work Email</label>
                                <input id="reg-email" 
                                       type="email" 
                                       class="form-input" 
                                       placeholder="grace@org.com" 
                                       @bind="registerEmail" 
                                       required />
                            </div>

                            <!-- Password with strength meter -->
                            <div class="form-field-group">
                                <label class="form-label" for="reg-password">Password</label>
                                <div class="input-container">
                                    <input id="reg-password" 
                                           type="@(showPassword ? "text" : "password")" 
                                           class="form-input" 
                                           placeholder="Create a strong password" 
                                           @bind="registerPassword" 
                                           @bind:event="oninput"
                                           required />
                                    <button type="button" class="btn-eye-toggle" @onclick="() => showPassword = !showPassword" title="Toggle password visibility">
                                        @if (showPassword)
                                        {
                                            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                                        }
                                        else
                                        {
                                            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        }
                                    </button>
                                </div>

                                <!-- Password Strength Indicator -->
                                <div class="strength-meter">
                                    <span class="strength-bar @(PasswordStrengthLevel >= 1 ? "active-weak" : "")"></span>
                                    <span class="strength-bar @(PasswordStrengthLevel >= 2 ? "active-medium" : "")"></span>
                                    <span class="strength-bar @(PasswordStrengthLevel >= 3 ? "active-strong" : "")"></span>
                                </div>
                                <span class="strength-text" style="color: @PasswordStrengthColor">
                                    @PasswordStrengthLabel
                                </span>
                            </div>

                            <!-- Terms Checkbox -->
                            <div class="form-options-row" style="margin: 0.75rem 0 1.25rem 0;">
                                <label class="checkbox-label" style="font-size: 0.78rem;">
                                    <input type="checkbox" class="custom-checkbox" @bind="agreeTerms" required />
                                    <span>I agree to the <a href="/terms" class="link-forgot">Terms</a> &amp; <a href="/privacy" class="link-forgot">Privacy Policy</a></span>
                                </label>
                            </div>

                            <!-- Create Account Button -->
                            <button type="submit" class="btn-primary-action" disabled="@(isSubmitting || !agreeTerms)">
                                @if (isSubmitting)
                                {
                                    <span style="display: inline-block; width: 14px; height: 14px; border: 2px solid #ffffff; border-top-color: transparent; border-radius: 50%; animation: spin 0.6s linear infinite;"></span>
                                    <span>Creating Account...</span>
                                }
                                else
                                {
                                    <span>Create Account</span>
                                }
                            </button>
                        </form>

                        <!-- Switch back to Login -->
                        <div class="switch-mode-prompt">
                            <span>Already have an account?</span>
                            <button type="button" class="btn-switch-mode btn-to-login" @onclick="ToggleMode">Sign in</button>
                        </div>
                    </div>
                }
            </div>

            <!-- PANEL 2: Graphic Showcase Panel (Right in Login mode, Slides to Left in Register mode) -->
            <div class="auth-panel panel-showcase">
                <AiShowcase />
            </div>
        </div>
    </div>
</div>

<!-- Dynamic Toast Notification Floating Alert -->
@if (activeToast != null)
{
    <div class="toast-container">
        <div class="custom-toast" style="@GetToastStyle(activeToast.Type)">
            <span>@activeToast.Text</span>
            <span style="cursor: pointer; opacity: 0.7; margin-left: auto;" @onclick="DismissToast">✕</span>
        </div>
    </div>
}

@code {
    public enum ToastType { Info, Success, Warning, Error }
    public record ToastMessage(ToastType Type, string Text);

    private bool isRegisterMode = false;
    private bool isFullscreen = false;
    private bool showPassword = false;
    private bool rememberMe = true;
    private bool showErrorAlert = true; // Shown by default to match user's screenshot!
    private bool isSubmitting = false;
    private bool agreeTerms = true;

    // Login fields
    private string loginEmail = "grace@org.com";
    private string loginPassword = "superSecretPassword123";

    // Register fields
    private string registerFullName = "";
    private string registerUsername = "";
    private string registerEmail = "";
    private string registerPassword = "";

    // Toast
    private ToastMessage? activeToast;

    private int PasswordStrengthLevel
    {
        get
        {
            if (string.IsNullOrEmpty(registerPassword)) return 0;
            int score = 0;
            if (registerPassword.Length >= 6) score++;
            if (registerPassword.Length >= 10 && registerPassword.Any(char.IsDigit)) score++;
            if (registerPassword.Any(ch => !char.IsLetterOrDigit(ch))) score++;
            return score;
        }
    }

    private string PasswordStrengthLabel => PasswordStrengthLevel switch
    {
        1 => "Weak password",
        2 => "Medium password strength",
        3 => "Strong & secure password",
        _ => "Enter at least 6 characters"
    };

    private string PasswordStrengthColor => PasswordStrengthLevel switch
    {
        1 => "#ef4444",
        2 => "#f59e0b",
        3 => "#10b981",
        _ => "#9ca3af"
    };

    private void ToggleMode()
    {
        isRegisterMode = !isRegisterMode;
        showErrorAlert = false;
        StateHasChanged();
    }

    private void ToggleFullscreen()
    {
        isFullscreen = !isFullscreen;
    }

    private void ToggleShowError()
    {
        showErrorAlert = !showErrorAlert;
    }

    private void ResetForm()
    {
        loginEmail = "grace@org.com";
        loginPassword = "superSecretPassword123";
        showErrorAlert = true;
        ShowToastNotification(new ToastMessage(ToastType.Info, "Form reset to initial screenshot demo state."));
    }

    private void HandleWindowClose() => ShowToastNotification(new ToastMessage(ToastType.Info, "macOS Close window simulated."));
    private void HandleWindowMinimize() => ShowToastNotification(new ToastMessage(ToastType.Info, "macOS Minimize window simulated."));
    private void HandleShare() => ShowToastNotification(new ToastMessage(ToastType.Success, "Link copied to clipboard!"));
    private void HandleTabsGrid() => ShowToastNotification(new ToastMessage(ToastType.Info, "Displaying multi-tab overview."));
    private void HandleForgotPassword() => ShowToastNotification(new ToastMessage(ToastType.Info, "Password reset link sent to your email!"));
    private void HandleTroubleSignIn() => ShowToastNotification(new ToastMessage(ToastType.Info, "Help Center: Contact support@labs.ai"));
    private void DismissToast() => activeToast = null;

    private async Task HandleLoginSubmit()
    {
        isSubmitting = true;
        StateHasChanged();

        await Task.Delay(1000); // Realistic network delay
        isSubmitting = false;

        // If demo password matches screenshot error demo
        if (loginPassword == "wrong" || (showErrorAlert && loginPassword != "superSecretPassword123"))
        {
            showErrorAlert = true;
            ShowToastNotification(new ToastMessage(ToastType.Error, "Authentication failed: Please check your password."));
        }
        else
        {
            showErrorAlert = false;
            ShowToastNotification(new ToastMessage(ToastType.Success, $"Welcome back to AI Labs, {loginEmail}!"));
        }
    }

    private async Task HandleRegisterSubmit()
    {
        isSubmitting = true;
        StateHasChanged();

        await Task.Delay(1200);
        isSubmitting = false;

        ShowToastNotification(new ToastMessage(ToastType.Success, $"Account created for @{registerUsername}! Welcome aboard!"));
        
        // Auto transition back to login or dashboard
        await Task.Delay(1500);
        isRegisterMode = false;
    }

    private void HandleSocialLoginGoogle()
    {
        ShowToastNotification(new ToastMessage(ToastType.Info, "Initiating Google OAuth 2.0 PKCE flow..."));
    }

    private void HandleSocialLoginGitHub()
    {
        ShowToastNotification(new ToastMessage(ToastType.Info, "Initiating GitHub OAuth flow..."));
    }

    private void ShowToastNotification(ToastMessage msg)
    {
        activeToast = msg;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            if (activeToast == msg)
            {
                activeToast = null;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private string GetToastStyle(ToastType type) => type switch
    {
        ToastType.Success => "background: #065f46; border-left: 4px solid #10b981;",
        ToastType.Error => "background: #7f1d1d; border-left: 4px solid #ef4444;",
        ToastType.Warning => "background: #78350f; border-left: 4px solid #f59e0b;",
        _ => "background: #0f172a; border-left: 4px solid #3b82f6;"
    };
}
