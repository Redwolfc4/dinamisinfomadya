@page "/"
@layout AuthLayout

<PageTitle>AI Labs — Select &amp; Combine &amp; Integrate</PageTitle>

<AuthSplitLayout IsRegisterMode="isRegisterMode">
    @if (!isRegisterMode)
    {
        <LoginForm OnSwitchToRegister="() => SetMode(true)"
                   OnNotify="HandleNotification" />
    }
    else
    {
        <RegisterForm OnSwitchToLogin="() => SetMode(false)"
                      OnNotify="HandleNotification" />
    }
</AuthSplitLayout>

@if (activeToast != null)
{
    <div class="toast-container">
        <div class="custom-toast" style="@GetToastStyle(activeToast.Type)">
            <span>@activeToast.Text</span>
            <span style="cursor: pointer; opacity: 0.7; margin-left: auto;" @onclick="DismissToast">✕</span>
        </div>
    </div>
}

@code {
    public record ToastMessage(string Type, string Text);

    private bool isRegisterMode = false;
    private ToastMessage? activeToast;

    private void SetMode(bool registerMode)
    {
        isRegisterMode = registerMode;
        StateHasChanged();
    }

    private void HandleNotification((string Type, string Message) notification)
    {
        ShowToastNotification(new ToastMessage(notification.Type, notification.Message));
    }

    private void DismissToast() => activeToast = null;

    private void ShowToastNotification(ToastMessage msg)
    {
        activeToast = msg;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            if (activeToast == msg)
            {
                activeToast = null;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private string GetToastStyle(string type) => type switch
    {
        "Success" => "background: #065f46; border-left: 4px solid #10b981;",
        "Error" => "background: #7f1d1d; border-left: 4px solid #ef4444;",
        "Warning" => "background: #78350f; border-left: 4px solid #f59e0b;",
        _ => "background: #0f172a; border-left: 4px solid #3b82f6;"
    };
}
