@inherits LayoutComponentBase
@using frontend.Layout
@inject IJSRuntime JS
@inject AuthApiService AuthApi
@inject NavigationManager Navigation

@if (isAuthorized)
{
    <div class="page">
        <div class="sidebar">
            <NavMenu OnLogoutClick="OpenLogoutModal" />
        </div>

        <main class="min-w-0 flex-1 overflow-y-auto">
            <div class="top-row px-4">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>

    <BaseModal IsOpen="showLogoutModal"
               Title="Konfirmasi Logout"
               MaxWidthClass="max-w-md"
               OnClose="CloseLogoutModal">
        <p class="text-sm text-slate-600 mb-6">
            Apakah Anda yakin ingin keluar dari aplikasi?
        </p>
        <div class="flex justify-end gap-2">
            <button type="button"
                    class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition cursor-pointer"
                    @onclick="CloseLogoutModal">
                Batal
            </button>
            <button type="button"
                    class="px-4 py-2 rounded-xl text-sm font-semibold bg-red-600 hover:bg-red-700 text-white transition cursor-pointer"
                    @onclick="ConfirmLogoutAsync">
                Ya, Logout
            </button>
        </div>
    </BaseModal>
}

@code {
    private bool isAuthorized = false;
    private bool showLogoutModal = false;

    private void OpenLogoutModal() => showLogoutModal = true;
    private void CloseLogoutModal() => showLogoutModal = false;

    private async Task ConfirmLogoutAsync()
    {
        showLogoutModal = false;
        await JS.InvokeVoidAsync("authCookie.remove", "dinamis_auth_token");
        await JS.InvokeVoidAsync("authCookie.remove", "dinamis_refresh_token");
        Navigation.NavigateTo("/login");
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string?>("authCookie.get", "dinamis_auth_token");

        if (string.IsNullOrWhiteSpace(token) || !await AuthApi.ValidateTokenAsync(token))
        {
            await JS.InvokeVoidAsync("authCookie.remove", "dinamis_auth_token");
            await JS.InvokeVoidAsync("authCookie.remove", "dinamis_refresh_token");
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        isAuthorized = true;
    }
}
